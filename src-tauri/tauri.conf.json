{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkiPDF",
  "version": "0.5.0",
  "identifier": "no.blad.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArkiPDF",
        "width": 1200,
        "height": 850,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; frame-src 'self' blob:; object-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "PDF-leser for tegninger",
    "longDescription": "ArkiPDF er en rask PDF-leser for tegninger: måling med målestokk, sammenslåing av tegningssett, presentasjon, sortering og eksport.",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF-dokument",
        "description": "PDF-dokument",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "Norwegian",
          "English"
        ]
      }
    }
  }
}
